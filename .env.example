# --- LLM (API compatible OpenAI, endpoint local) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=sk-local
LLM_MODEL=local-model
SYSTEM_PROMPT=Tu es un assistant utile et concis.
# Durée max d'une requête au LLM (envoi -> fin de réponse). En mode
# non-streamé, le serveur n'envoie ses en-têtes qu'une fois la réponse
# entièrement générée : à augmenter sur une machine peu puissante si
# "timeout awaiting response headers". 0 = aucune limite.
LLM_TIMEOUT=10m

# Gestion du contexte de conversation
LLM_CONTEXT_TOKENS=8192
CONTEXT_COMPACT_AT=0.95
CONTEXT_KEEP_LAST=6

# --- IMAP (lecture des mails) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=bot@example.com
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX
IMAP_TLS=true

# --- SMTP (envoi des réponses) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bot@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=bot@example.com
# starttls | tls | none
SMTP_TLS_MODE=starttls

# --- Mode mail ---
POLL_INTERVAL=60s

# Liste blanche des expéditeurs autorisés à déclencher une réponse auto,
# séparés par des virgules. Vide = tout le monde autorisé.
MAIL_ALLOW_FROM=
MAIL_MAX_BODY_CHARS=12000

# --- Tool calling ---
# Mode chat : shell + fichiers + http, supervisé par un humain.
CHAT_TOOLS_ENABLED=true
# Mode mail : lecture fichier + http + shell si activé (jamais write_file).
# ATTENTION : le corps d'un mail entrant est un contenu non fiable (voir
# MAIL_ALLOW_FROM ci-dessus, lui-même vulnérable au spoofing du From) —
# activer run_shell ici est un vecteur d'injection de prompt -> exécution de
# code arbitraire, à n'activer qu'en connaissance de cause. Si
# SANDBOX_USER_ENABLED=true, run_shell n'est proposé en mode mail que
# si le sandbox a déjà été configuré via le mode chat (mode mail ne peut pas
# demander le mot de passe sudo nécessaire pour le mettre en place lui-même).
MAIL_TOOLS_ENABLED=false

# Si true (défaut), run_shell s'exécute sous un compte système dédié et
# restreint ("llm") plutôt que sous l'utilisateur courant. Contrôle aussi le
# contrôle d'accès de read_file/write_file : un répertoire est alors considéré
# autorisé si ce compte y a réellement accès au niveau OS (vérifié à chaque
# appel), plutôt que parce qu'il figure dans un fichier de permissions — donc
# pas seulement "shell" malgré le nom. Au premier lancement du mode chat, le
# programme explique et effectue (avec confirmation) la configuration
# nécessaire : création de l'utilisateur/groupe système "llm", ajout de
# l'utilisateur courant à ce groupe, règle sudo limitée. Jamais de chown :
# seuls les répertoires accordés via request_directory_access ont leur groupe
# changé vers "llm" (chgrp).
SANDBOX_USER_ENABLED=true

TOOLS_SHELL_TIMEOUT=30s
TOOLS_HTTP_TIMEOUT=20s
# browser_fetch (navigateur headless, voir plus bas) : plus long par défaut
# que TOOLS_HTTP_TIMEOUT, le démarrage d'un navigateur (et de geckodriver
# pour Firefox) prenant plus de temps qu'une simple requête HTTP.
TOOLS_BROWSER_FETCH_TIMEOUT=45s
AGENT_MAX_STEPS=8
# Nombre d'échecs run_shell d'affilée (code de sortie non nul, timeout, ou
# erreur du tool) au-delà duquel un message est injecté pour pousser le
# modèle à changer d'approche plutôt qu'à retenter indéfiniment la même
# commande qui échoue. Remis à zéro dès qu'un run_shell réussit. <= 0 =
# désactivé.
AGENT_MAX_CONSECUTIVE_SHELL_FAILURES=5
# Durée de la fenêtre ouverte quand le modèle demande
# "as_real_user_window": true sur run_shell et que l'utilisateur confirme :
# les commandes "as_real_user" suivantes sont alors autorisées sans
# redemander tant que la fenêtre est ouverte. Sans "as_real_user_window"
# (mode "oneshot", par défaut), chaque commande "as_real_user" redemande
# confirmation individuellement, quelle que soit cette valeur.
AGENT_REAL_USER_WINDOW=5m

# --- Workspace ---
# Répertoire toujours accessible en lecture/écriture pour read_file/
# write_file (chat comme mail), sans passer par request_directory_access.
# Contient un sous-répertoire "skills/" où déclarer des skills (voir
# internal/skills et le README). Défaut : "bot-workspace" dans le dossier
# personnel de l'utilisateur courant.
WORKSPACE_DIR=
